{
  "name": "lex-launcher",
  "version": "0.1.0",
  "description": "LEX CLIENT — launcher funcional para Minecraft Bedrock (Electron + React).",
  "author": "LEX CLIENT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"electron .\"",
    "dev:vite": "vite --port 5173 --strictPort",
    "prebuild": "node ../../scripts/copy-catalog.mjs",
    "build": "vite build",
    "start": "electron .",
    "prepackage": "node ../../scripts/copy-catalog.mjs && node ../../scripts/copy-overlay.mjs",
    "package": "electron-builder --config electron-builder.yml",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^28",
    "@lex/compatibility": "*",
    "@lex/cosmetics": "*",
    "@lex/module-sdk": "*",
    "@lex/shared": "*",
    "@lex/ui-components": "*",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^24",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "concurrently": "^9",
    "electron-builder": "^25",
    "tailwindcss": "^4",
    "typescript": "^5.6",
    "vite": "^6"
  }
}
