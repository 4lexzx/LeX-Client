{
  "name": "lex-client",
  "productName": "LeX Client",
  "version": "0.6.0",
  "description": "Launcher de LeX Client para Minecraft Bedrock",
  "author": "LeX Client",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lexclient.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "shared/**",
      "assets/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native"
      }
    ],
    "win": {
      "icon": "renderer/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LeX Client",
      "installerIcon": "renderer/icon.ico",
      "uninstallerIcon": "renderer/icon.ico",
      "artifactName": "LeX-Client-Setup-${version}.${ext}",
      "runAfterFinish": false
    }
  }
}
